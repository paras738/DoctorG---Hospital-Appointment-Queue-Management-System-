# DoctorG Environment Variables
# Copy this file to .env and fill in your keys

# Supabase (Free Tier: 500MB DB, 200 Realtime connections)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Razorpay (TEST MODE ONLY - Never put live keys here)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
# Note: RAZORPAY_KEY_SECRET is configured ONLY in Supabase Edge Functions Secrets!

# Google Maps API (Free Tier $200 monthly credit)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Configuration
APP_ENV=development
API_TIMEOUT_SECONDS=15
